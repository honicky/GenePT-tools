# AWS Batch Training Configuration
# Copy this file to .env and fill in your values

# AWS Account Configuration
AWS_ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE
AWS_DEFAULT_REGION=us-east-1

# ECR Repository
ECR_REPOSITORY_NAME=genept-training

# EBS Snapshot with training data
# This snapshot should contain your pre-populated training data
DATA_SNAPSHOT_ID=snap-0b1c573caa4318e2f

# VPC Configuration (optional - will use defaults if not specified)
# VPC_SUBNET_1=subnet-xxxxxxxx
# VPC_SUBNET_2=subnet-yyyyyyyy
# SECURITY_GROUP_ID=sg-xxxxxxxx

# Compute Environment Settings
MAX_VCPUS=256
SPOT_BID_PERCENTAGE=80

# S3 Buckets
CONFIG_BUCKET=genept-training-configs
OUTPUT_BUCKET=genept-training-outputs

# Secrets (DO NOT commit actual values)
WANDB_API_KEY=your_wandb_api_key_here

# Job Queue Configuration
JOB_QUEUE_NAME=genept-training-queue
COMPUTE_ENV_NAME=genept-gpu-training-spot

# Instance Types (comma separated)
# g5.xlarge = 1 GPU, 4 vCPU, 16GB RAM
# g5.2xlarge = 1 GPU, 8 vCPU, 32GB RAM  
# g5.4xlarge = 1 GPU, 16 vCPU, 64GB RAM
INSTANCE_TYPES=g5.xlarge,g5.2xlarge,g5.4xlarge

# Project Tags
PROJECT_NAME=GenePT
ENVIRONMENT=training
TEAM=ml-team

# CloudWatch Settings
LOG_GROUP_NAME=/aws/batch/genept-training
LOG_RETENTION_DAYS=30

# Training Defaults (can be overridden per job)
DEFAULT_EPOCHS=50
DEFAULT_BATCH_SIZE=512
DEFAULT_LEARNING_RATE=0.001

# Monitoring
ENABLE_GPU_METRICS=true
METRICS_NAMESPACE=GenePT/GPU

# Cost Optimization
USE_SPOT_INSTANCES=true
ENABLE_AUTO_SCALING=true
MIN_VCPUS=0
DESIRED_VCPUS=0